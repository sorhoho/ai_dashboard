# ── AWS Credentials ────────────────────────────────────────────────────────────
# If running on AWS (EC2/ECS/Lambda) with an IAM role attached, leave these
# blank — the SDK picks up the role automatically via the metadata service.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Kiro S3 Report Settings ────────────────────────────────────────────────────
# The S3 bucket you configured in Kiro Console → Settings → User Activity Reports
KIRO_S3_BUCKET=

# Prefix / folder inside the bucket where Kiro drops the CSV files.
# Kiro writes:  s3://<bucket>/<prefix><YYYY-MM-DD>/user-activity-report.csv
# Default matches the Kiro default delivery path.
KIRO_S3_PREFIX=kiro-reports/

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
